export component MainWindow inherits Window {
    preferred-width: 640px;
    preferred-height: 480px;
    background: #2b2b3d;

    Text {
        text: "Hello from Ferric-K";
        color: white;
        font-size: 24px;
        horizontal-alignment: center;
        y: 20px;
        width: 100%;
        height: 40px;
    }

    Rectangle {
        x: (parent.width - 200px) / 2;
        y: 100px;
        width: 200px;
        height: 120px;
        background: #4a90d9;
        border-radius: 8px;
    }
}
