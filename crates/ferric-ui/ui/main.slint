import "DejaVuSans.ttf";
import "DejaVuSans-Bold.ttf";

export component MainWindow inherits Window {
    preferred-width: 640px;
    preferred-height: 480px;
    background: #2b2b3d;
    default-font-family: "DejaVu Sans";

    Text {
        text: "Ferric-K / DejaVu Sans";
        color: white;
        font-size: 32px;
        horizontal-alignment: center;
        y: 20px;
        width: 100%;
        height: 40px;
    }

    Text {
        text: "16px regular";
        color: #cfd0e0;
        font-size: 16px;
        x: 40px;
        y: 90px;
        width: 300px;
    }

    Text {
        text: "24px regular";
        color: #cfd0e0;
        font-size: 24px;
        x: 40px;
        y: 130px;
        width: 300px;
    }

    Text {
        text: "24px bold";
        color: #ffd24a;
        font-size: 24px;
        font-weight: 700;
        x: 40px;
        y: 170px;
        width: 300px;
    }

    Text {
        text: "32px bold";
        color: #ffd24a;
        font-size: 32px;
        font-weight: 700;
        x: 330px;
        y: 110px;
        width: 280px;
    }

    Rectangle {
        x: 40px;
        y: 230px;
        width: 160px;
        height: 110px;
        background: #4a90d9;
        border-radius: 8px;
    }

    Rectangle {
        x: 230px;
        y: 230px;
        width: 160px;
        height: 110px;
        background: #d94a6e;
        border-radius: 8px;
    }
}
